{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jrs-methodology-correspondence-record/0.1.0",
  "title": "JRS methodology correspondence record",
  "description": "INTERNAL. One record states whether a candidate, workspace, Manifest or research term has an owner-approved correspondence to a methodology source term. A shared word, a similar concept or a plausible interpretation does not establish a correspondence. Rules a JSON schema cannot state (approval requirements, source-hash binding, the ban on EXACT_LABEL and DOCUMENTED_ALIAS without approval) are enforced by tools/methodology-integrity/lib/validate.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["correspondence_id", "methodology_source_id", "methodology_source_sha256", "authoritative_source_term", "candidate_term", "term_category", "term_location", "mapping_type", "status", "evidence_basis", "source_reference", "limitation", "proposal", "owner_approval", "change_history"],
  "properties": {
    "correspondence_id": { "type": "string", "pattern": "^MC-[0-9]{3}$" },
    "methodology_source_id": { "type": ["string", "null"], "pattern": "^SRC-[A-Z-]+$" },
    "methodology_source_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "authoritative_source_term": { "type": ["string", "null"], "minLength": 1 },
    "candidate_term": { "type": "string", "minLength": 1 },
    "term_category": { "enum": ["JRS_CONDITION", "CANDIDATE_KEY", "CANDIDATE_EXPLANATION_CATEGORY", "CANDIDATE_FLAW_TYPE", "SOURCE_PREP_CHECK", "MODEL_OUTPUT_CHECK", "WORKSPACE_LABEL", "WORKSPACE_DISPOSITION", "MANIFEST_FIELD", "MANIFEST_VALUE", "RESEARCH_TERM", "HISTORICAL_ENGINE_KEY"] },
    "term_location": {
      "type": "object", "additionalProperties": false, "required": ["path", "reference"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "reference": { "type": "string", "minLength": 1 } }
    },
    "mapping_type": { "enum": ["EXACT_LABEL", "DOCUMENTED_ALIAS", "IMPLEMENTATION_REFERENCE", "DISPLAY_LABEL", "NO_CORRESPONDENCE_ASSERTED"] },
    "status": { "enum": ["APPROVED_CORRESPONDENCE", "UNMAPPED", "PROPOSED_NOT_APPROVED", "HISTORICAL_REFERENCE_ONLY", "NOT_ASSESSED", "RETIRED"] },
    "evidence_basis": { "type": "string", "minLength": 1 },
    "source_reference": { "type": ["string", "null"], "minLength": 1 },
    "limitation": { "type": "string", "minLength": 1 },
    "proposal": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["proposed_source_id", "proposed_source_term", "reference", "note"],
      "properties": { "proposed_source_id": { "type": "string", "pattern": "^SRC-[A-Z-]+$" }, "proposed_source_term": { "type": "string", "minLength": 1 }, "reference": { "type": "string", "minLength": 1 }, "note": { "type": "string", "minLength": 1 } }
    },
    "owner_approval": {
      "type": "object", "additionalProperties": false, "required": ["approved", "approver", "approval_date", "approval_reference"],
      "properties": {
        "approved": { "type": "boolean" },
        "approver": { "type": ["string", "null"], "minLength": 1 },
        "approval_date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "approval_reference": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "change_history": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["date", "change"], "properties": { "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, "change": { "type": "string", "minLength": 1 } } }
    }
  }
}
