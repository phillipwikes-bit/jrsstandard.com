  "synthetic_vs_independent": "All results in this freeze are local engineering checks on synthetic material, run by the team that built the candidate. An independent evaluation would use authorized material, independent labelers blind to candidate output, an adjudicator, a frozen candidate and a sealed protocol. None has been authorized or conducted, and no result here stands in for one.",
  "roles": [
    {
      "role": "owner",
      "duties": "Authorizes each gate; does not label, adjudicate or operate.",
      "may_view_sealed_labels": false
    },
    {
      "role": "data_custodian",
      "duties": "Holds and releases authorized material; keeps sealed labels outside the repository.",
      "may_view_sealed_labels": true
    },
    {
      "role": "independent_labeler",
      "duties": "Labels material blind to candidate output; independent of the developers and of each other.",
      "may_view_sealed_labels": true
    },
    {
      "role": "adjudicator",
      "duties": "Resolves disputed labels under the written rule; does not label the same item.",
      "may_view_sealed_labels": true
    },
    {
      "role": "technical_operator",
      "duties": "Runs the frozen candidate in the recorded environment; never sees labels before Gate E.",
      "may_view_sealed_labels": false
    },
    {
      "role": "counsel_or_privacy_reviewer",
      "duties": "Reviews material authorization, privacy and disclosure before Gate A and at Gate F.",
      "may_view_sealed_labels": false
    }
  ],
