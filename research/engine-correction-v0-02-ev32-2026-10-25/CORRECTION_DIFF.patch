+// RP-CON-02 (V0-02 correction): the event role of a cited quotation is the role of the explicitly
+// dated event(s) whose clause overlaps the quotation's span; null when none or more than one role.
+export function eventRoleOf(e, events = []) {
+  const m = /^span:(\d+)-(\d+)$/.exec(e.span_id || '');
+  if (!m) return null;
+  const s = Number(m[1]), t = Number(m[2]);
+  const roles = [...new Set(events.filter((ev) => ev.start < t && s < ev.end).map((ev) => ev.role))];
+  return roles.length === 1 ? roles[0] : null;
