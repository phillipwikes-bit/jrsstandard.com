{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jrs:private:review-run-envelope:0.1.0",
  "title": "JRS Review Run Envelope 0.1.0 (private, local)",
  "description": "Private, local, machine-readable identity and result record for one run of the JRS Review Engine candidate under the assurance package. It is not a public API contract and is not the Decision Reconstruction Manifest. Structural rules are below; cross-field rules R1-R12 are enforced by lib/engine-assurance/envelope.mjs and listed in contracts/REVIEW_RUN_ENVELOPE.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "engine_version", "codebook_version", "assurance_layer_version", "condition_vocabulary",
    "fixture_id", "fixture_content_hash", "run_id", "run_timestamp", "execution_mode", "provider_mode",
    "provider_invocations", "source_identity_status", "source_identity", "test_or_demo_status", "release_status",
    "limitations", "human_review_required", "gate", "findings", "refusals", "manifest_reference", "artifact_hashes"
  ],
  "properties": {
    "schema_version": { "const": "jrs-review-run-envelope/0.1.0" },
    "engine_version": { "type": "string", "enum": ["0.1.0-validation"] },
    "codebook_version": { "type": "string", "enum": ["1.0"] },
    "assurance_layer_version": { "type": "string", "enum": ["0.1.0-local"] },
    "condition_vocabulary": { "const": "review_engine_keys" },
    "fixture_id": { "type": "string", "pattern": "^[A-Z]{2,6}-[0-9]{3}$" },
    "fixture_content_hash": { "$ref": "#/$defs/hash" },
    "run_id": { "type": "string", "pattern": "^run_[0-9a-f]{24}$" },
    "run_timestamp": { "type": "string", "format": "date-time" },
    "execution_mode": { "type": "string", "enum": ["local_mocked", "local_deterministic", "external_not_authorized"] },
    "provider_mode": { "type": "string", "enum": ["mocked", "not_used"] },
    "provider_invocations": { "type": "integer", "minimum": 0, "maximum": 1 },
    "source_identity_status": { "type": "string", "enum": ["candidate_core_matches_git_history", "candidate_core_provenance_not_verified"] },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_source_path", "candidate_source_commit", "candidate_source_blob", "repository_head", "working_tree"],
      "properties": {
        "candidate_source_path": { "type": "string", "minLength": 1 },
        "candidate_source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "candidate_source_blob": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "repository_head": { "type": "string", "pattern": "^([0-9a-f]{40}|unknown)$" },
        "working_tree": { "type": "string", "enum": ["clean", "modified_uncommitted", "unknown"] }
      }
    },
    "test_or_demo_status": { "type": "string", "enum": ["synthetic_engineering_test", "synthetic_demonstration"] },
    "release_status": { "const": "NO_GO_NOT_VERIFIED" },
    "limitations": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^L-[0-9]{2}$" },
          "statement": { "type": "string", "minLength": 20, "maxLength": 600 }
        }
      }
    },
    "human_review_required": { "const": true },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "trigger_codes"],
      "properties": {
        "decision": { "type": "string", "enum": ["proceed", "refuse", "escalate"] },
        "trigger_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_findings", "record_controls"],
      "properties": {
        "condition_findings": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/condition_finding" } },
        "record_controls": { "type": "array", "items": { "$ref": "#/$defs/record_control" } }
      }
    },
    "refusals": { "type": "array", "items": { "$ref": "#/$defs/refusal" } },
    "manifest_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["produced", "reason"],
      "properties": {
        "produced": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
        "represents": { "const": "unmodified_v1_candidate_output" },
        "manifest_id": { "type": "string", "format": "uuid" },
        "manifest_version": { "type": "string", "enum": ["1.0"] },
        "manifest_hash": { "$ref": "#/$defs/hash" },
        "engine_version": { "type": "string", "minLength": 1 },
        "codebook_version": { "type": "string", "minLength": 1 },
        "jrs_version": { "type": "string", "minLength": 1 },
        "offline_validation": { "type": "string", "enum": ["schema_valid_and_self_consistent", "failed"] }
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "request", "normalized_output", "code"],
      "properties": {
        "record": { "$ref": "#/$defs/hash" },
        "request": { "$ref": "#/$defs/hash" },
        "provider_response": { "$ref": "#/$defs/hash" },
        "normalized_output": { "$ref": "#/$defs/hash" },
        "code": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/hash" } }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "start", "end", "offset_unit", "occurrence_count", "verification"],
      "properties": {
        "quote": { "type": "string", "minLength": 8, "maxLength": 400 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "offset_unit": { "const": "utf16_code_unit" },
        "occurrence_count": { "type": "integer", "minimum": 1 },
        "verification": { "const": "exact_match_record_presence_only" }
      }
    },
    "condition_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "condition_label", "outcome", "outcome_basis", "candidate_status", "explanation",
        "explanation_content_class", "source_spans", "evidence_classification", "limitation", "what_would_change_this_finding"],
      "properties": {
        "condition_id": { "type": "string", "enum": ["basis_identification", "reasoning_traceability", "cold_reviewer_clarity", "accountability_support", "temporal_reconstructability"] },
        "condition_label": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "enum": ["supported", "gap", "review_required", "not_assessed"] },
        "outcome_basis": { "type": "string", "enum": [
          "candidate_status_with_verified_span", "candidate_status_review", "no_source_anchor_supplied",
          "candidate_citation_not_found", "unsafe_language_in_candidate_note", "candidate_note_missing",
          "candidate_output_invalid", "pre_analysis_refusal", "pre_analysis_escalation", "deterministic_mode_not_assessed",
          "execution_mode_not_authorized"] },
        "candidate_status": { "type": "string", "enum": ["pass", "review", "gap", "none"] },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 400 },
        "explanation_content_class": { "type": "string", "enum": ["derived_record_content", "no_record_content"] },
        "source_spans": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/span" } },
        "evidence_classification": { "type": "string", "enum": ["contains_record", "derived_record_content", "no_verified_record_support"] },
        "limitation": { "type": "string", "minLength": 40, "maxLength": 600 },
        "what_would_change_this_finding": { "type": "string", "minLength": 20, "maxLength": 400 }
      }
    },
    "record_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "control_name", "scope", "detect", "reflect", "correct", "learn", "route"],
      "properties": {
        "control_id": { "type": "string", "enum": ["CC-01", "CC-02", "CC-03", "CC-04", "CC-05", "CC-06"] },
        "control_name": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 20 },
        "detect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern_id", "summary", "spans"],
          "properties": {
            "pattern_id": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
            "spans": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/span" } }
          }
        },
        "reflect": { "type": "string", "minLength": 1, "maxLength": 400 },
        "correct": { "type": "string", "minLength": 1, "maxLength": 400 },
        "learn": { "type": "string", "minLength": 1, "maxLength": 400 },
        "route": { "const": "human_review" }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "disposition", "category", "boundary"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "enum": ["pre_analysis", "post_analysis", "execution"] },
        "disposition": { "type": "string", "enum": ["refuse", "escalate", "withhold"] },
        "category": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "condition_id": { "type": "string" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "matched_text", "offset_unit"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 1 },
            "matched_text": { "type": "string" },
            "offset_unit": { "const": "utf16_code_unit" }
          }
        }
      }
    }
  }
}
